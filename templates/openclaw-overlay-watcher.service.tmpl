[Unit]
Description=OpenClaw overlay watcher for ${USERNAME}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/openclaw-overlay-watcher --username ${USERNAME} --config /home/${USERNAME}/.openclaw/openclaw.json --snapshot /home/${USERNAME}/.openclaw-overlay/watcher.state --socket ${OVERLAY_SOCKET}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
