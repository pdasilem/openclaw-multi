[Unit]
Description=OpenClaw Overlay API Daemon
After=network.target
Requires=network.target

[Service]
Type=simple
User=root
RuntimeDirectory=openclaw-multi
ExecStart=/usr/local/bin/openclaw-overlay-api --config /etc/openclaw-multi/config.yml --state /var/lib/openclaw-multi/state.db --socket /run/openclaw-overlay.sock --cloudflared-config /etc/cloudflared/config.yml --audit-log /var/log/openclaw-multi/audit.log
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
